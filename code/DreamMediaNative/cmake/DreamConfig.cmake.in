@PACKAGE_INIT@

set(Dream_SUPPORTED_COMPONENTS Player Recorder)

include("${CMAKE_CURRENT_LIST_DIR}/DreamPlayerTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/DreamRecorderTargets.cmake")

foreach(_comp ${Dream_SUPPORTED_COMPONENTS})
    if(TARGET Dream::${_comp})
        set(Dream_${_comp}_FOUND TRUE)
    endif()
endforeach()

check_required_components(Dream)